.ds-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ds-ring__canvas {
  width: 100%;
  height: 100%;
}

.ds-ring__label {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
