{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page Recipe",
  "description": "Agent 组合页面用的配方：只允许用已存在的组件与已公开的 token。由 scripts/recipe.mjs 校验。",
  "type": "object",
  "required": ["id", "app", "page", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^recipe-[a-z0-9-]+$" },
    "app": { "type": "string", "enum": ["ride", "ledger"] },
    "page": { "type": "string", "pattern": "^pages/[a-z0-9-]+/index$" },
    "intent": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string", "description": "必须出现在该 app 的组件契约里" },
          "props": { "type": "object", "description": "必须匹配契约里的 props：必填、枚举、类型" },
          "tokens": {
            "type": "array",
            "items": { "type": "string" },
            "description": "该实例显式消费的 token，必须存在且为业务可见"
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
