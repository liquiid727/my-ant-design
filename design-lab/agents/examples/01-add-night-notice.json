{
  "id": "tcp-add-night-notice",
  "author": "agent",
  "intent": "夜间骑行需要一个低饱和的提示色，现有 status.warning 太抢眼",
  "rationale": "status.warning 是给错误提示用的；夜间沉浸模式需要更柔和的提醒，且必须同时有深色值。",
  "scope": {
    "app": "ride",
    "brand": "cycling",
    "theme": "both"
  },
  "changes": [
    {
      "op": "add",
      "path": "color.action.notice",
      "type": "color",
      "value": "{color.ramp.amber.400}"
    }
  ]
}
