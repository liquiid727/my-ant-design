{
  "$description": "第二个品牌包：与骑行视觉完全相反——冷白 / 砖红 / 无衬线 / 小圆角。只覆盖白名单内的键。",
  "brand": {
    "palette": {
      "$type": "color",
      "canvas": { "$value": "#F6F7F9" },
      "raised": { "$value": "#FFFFFF" },
      "ink": { "$value": "#14161A" },
      "ink-soft": { "$value": "#4C5562" },
      "ink-mute": { "$value": "#636C78" },
      "brick": { "$value": "#B4341E" },
      "brick-hover": { "$value": "#9A2C19" },
      "brick-pressed": { "$value": "#7F2414" }
    }
  },
  "color": {
    "surface": {
      "$type": "color",
      "canvas": { "$value": "{brand.palette.canvas}" },
      "raised": { "$value": "{brand.palette.raised}" },
      "sunken": { "$value": "#EDEFF3" },
      "inverse": { "$value": "{brand.palette.ink}" },
      "accent-soft": { "$value": "#FDECE8" }
    },
    "ink": {
      "$type": "color",
      "primary": { "$value": "{brand.palette.ink}" },
      "secondary": { "$value": "{brand.palette.ink-soft}" },
      "tertiary": { "$value": "{brand.palette.ink-mute}" }
    },
    "action": {
      "$type": "color",
      "primary": { "$value": "{brand.palette.brick}" },
      "primary-hover": { "$value": "{brand.palette.brick-hover}" },
      "primary-pressed": { "$value": "{brand.palette.brick-pressed}" },
      "on-primary": { "$value": "{color.ramp.neutral.0}" },
      "secondary": { "$value": "{brand.palette.ink}" },
      "on-secondary": { "$value": "{color.ramp.neutral.0}" }
    },
    "border": {
      "$type": "color",
      "subtle": { "$value": "#E4E7EC" },
      "strong": { "$value": "#D3D7DE" },
      "focus": { "$value": "{brand.palette.brick}" }
    },
    "brand": {
      "$type": "color",
      "mark": { "$value": "{brand.palette.brick}" },
      "halo": { "$value": "#FDECE8" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "6px" },
    "card": { "$value": "10px" },
    "sheet": { "$value": "16px" }
  },
  "type": {
    "display": {
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.26}" },
      "line": { "$type": "dimension", "$value": "{font.line.32}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.bold}" },
      "tracking": { "$type": "dimension", "$value": "-0.5px" }
    },
    "title": {
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "{font.size.18}" },
      "line": { "$type": "dimension", "$value": "{font.line.24}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "tracking": { "$type": "dimension", "$value": "-0.2px" }
    },
    "metric": {
      "family": { "$type": "fontFamily", "$value": "{font.family.mono}" },
      "size": { "$type": "dimension", "$value": "{font.size.32}" },
      "line": { "$type": "dimension", "$value": "{font.line.38}" },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "tracking": { "$type": "dimension", "$value": "-0.6px" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "subtle": { "$value": "0 1px 2px rgba(20,22,26,0.06)" },
    "raised": { "$value": "0 8px 24px rgba(20,22,26,0.10)" }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "spring": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
