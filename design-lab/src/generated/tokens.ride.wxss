/* 浅色：定义在 page 上，自定义属性会继承进所有自定义组件 */
page {
  --badge-bg: #d8e4c8;
  --badge-ink: #212d1e;
  --badge-locked-bg: #e6e3d7;
  --badge-size: 128rpx;
  --button-bg: #b7ce5e;
  --button-border-width: 1px;
  --button-fg: #212d1e;
  --button-font-size: 28rpx;
  --button-gap: 16rpx;
  --button-ghost-border: #d0cdbf;
  --button-height: 88rpx;
  --button-padding-inline: 40rpx;
  --button-pressed-scale: 0.97;
  --button-radius: 28rpx;
  --button-secondary-bg: #4e633d;
  --button-secondary-fg: #ffffff;
  --card-bg: #fffcf2;
  --card-border: #e6e3d7;
  --card-gap: 24rpx;
  --card-padding: 32rpx;
  --card-radius: 40rpx;
  --card-shadow: 0px 1px 2px rgba(23, 24, 15, 0.06);
  --color-achievement-bronze: #ab7b5d;
  --color-achievement-gold: #e3b97e;
  --color-achievement-locked: #e6e3d7;
  --color-achievement-silver: #d0cdbf;
  --color-action-ghost-border: #d0cdbf;
  --color-action-on-primary: #212d1e;
  --color-action-on-secondary: #ffffff;
  --color-action-primary: #b7ce5e;
  --color-action-primary-hover: #ccdf82;
  --color-action-primary-pressed: #96ac42;
  --color-action-secondary: #4e633d;
  --color-border-focus: #6c8455;
  --color-border-strong: #d0cdbf;
  --color-border-subtle: #e6e3d7;
  --color-brand-halo: #e9f0df;
  --color-brand-mark: #6c8455;
  --color-ink-inverse: #faf8f1;
  --color-ink-on-accent: #212d1e;
  --color-ink-primary: #212d1e;
  --color-ink-secondary: #3b4a34;
  --color-ink-tertiary: #666a57;
  --color-overlay-scrim: rgba(23, 24, 15, 0.42);
  --color-postcard-hill: #e9f0df;
  --color-postcard-ink: #212d1e;
  --color-postcard-paper: #ffffff;
  --color-postcard-sky: #ddeaf0;
  --color-postcard-stamp: #6c8455;
  --color-postcard-sun: #f0d5a6;
  --color-route-detour: #cf9c57;
  --color-route-elevation: #c99c80;
  --color-route-primary: #b7ce5e;
  --color-route-surface: #d8e4c8;
  --color-route-water: #7c9ead;
  --color-status-danger: #8a4a5e;
  --color-status-danger-soft: #f7dfe4;
  --color-status-info: #46656f;
  --color-status-info-soft: #ddeaf0;
  --color-status-success: #4e633d;
  --color-status-success-soft: #e9f0df;
  --color-status-warning: #84592e;
  --color-status-warning-soft: #f7e8cc;
  --color-surface-accent-soft: #d8e4c8;
  --color-surface-canvas: #f7f4e9;
  --color-surface-inverse: #212d1e;
  --color-surface-raised: #fffcf2;
  --color-surface-sunken: #f2f0e6;
  --elevation-overlay: 0px 24px 64px rgba(23, 24, 15, 0.18);
  --elevation-raised: 0px 12px 32px rgba(33, 45, 30, 0.12);
