  --metric-label-size: 22rpx;
  --metric-label-tracking: 2rpx;
  --metric-muted-ink: #666a57;
  --metric-muted-size: 44rpx;
  --metric-unit-gap: 6rpx;
  --metric-unit-size: 20rpx;
  --metric-value-line: 88rpx;
  --metric-value-size: 80rpx;
  --motion-duration-base: 220ms;
  --motion-duration-celebrate: 700ms;
  --motion-duration-fast: 140ms;
  --motion-duration-sheet: 380ms;
  --motion-duration-slow: 320ms;
  --motion-easing-enter: cubic-bezier(0.05, 0.7, 0.1, 1);
  --motion-easing-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);
  --nav-bg: #f7f4e9;
  --nav-border: #e6e3d7;
  --nav-height: 112rpx;
  --nav-ink: #666a57;
  --nav-ink-active: #212d1e;
  --radius-card: 40rpx;
  --radius-control: 28rpx;
  --radius-pill: 1998rpx;
  --radius-sheet: 56rpx;
  --ring-fill: #b7ce5e;
  --ring-ink: #212d1e;
  --ring-size: 192rpx;
  --ring-stroke: 12rpx;
  --ring-track: #f2f0e6;
  --route-card-gap: 24rpx;
  --route-card-map-height: 264rpx;
  --route-card-padding: 32rpx;
  --route-stat-gap: 8rpx;
  --sheet-bg: #fffcf2;
  --sheet-handle: #d0cdbf;
  --sheet-padding: 40rpx;
  --sheet-radius: 56rpx;
  --sheet-scrim: rgba(23, 24, 15, 0.42);
  --size-control-height: 88rpx;
  --size-nav-height: 112rpx;
  --size-touch-min: 88rpx;
  --space-gutter: 32rpx;
  --space-inline: 24rpx;
  --space-page: 40rpx;
  --space-section: 64rpx;
  --space-stack: 16rpx;
  --type-body-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --type-body-line: 44rpx;
  --type-body-size: 28rpx;
  --type-body-tracking: 0px;
  --type-body-weight: 400;
  --type-caption-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --type-caption-line: 36rpx;
  --type-caption-size: 24rpx;
  --type-caption-tracking: 0px;
  --type-caption-weight: 400;
  --type-data-family: 'SF Mono', ui-monospace, Menlo, monospace;
  --type-data-line: 36rpx;
  --type-data-size: 24rpx;
  --type-data-tracking: 1rpx;
  --type-data-weight: 400;
  --type-display-family: 'Songti SC', 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  --type-display-line: 76rpx;
  --type-display-size: 64rpx;
  --type-display-tracking: -1rpx;
  --type-display-weight: 600;
  --type-heading-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --type-heading-line: 48rpx;
  --type-heading-size: 36rpx;
  --type-heading-tracking: 0px;
  --type-heading-weight: 600;
  --type-label-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  --type-label-line: 32rpx;
  --type-label-size: 22rpx;
  --type-label-tracking: 2rpx;
  --type-label-weight: 600;
  --type-metric-family: 'SF Mono', ui-monospace, Menlo, monospace;
  --type-metric-line: 88rpx;
  --type-metric-size: 80rpx;
  --type-metric-tracking: -1rpx;
  --type-metric-weight: 600;
  --type-title-family: 'Songti SC', 'Source Han Serif SC', 'Noto Serif SC', Georgia, serif;
  --type-title-line: 56rpx;
  --type-title-size: 44rpx;
  --type-title-tracking: 0px;
  --type-title-weight: 600;
}

