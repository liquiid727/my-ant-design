/* 浅色：定义在 page 上，自定义属性会继承进所有自定义组件 */
page {
  --badge-bg: #ededf1;
  --badge-ink: #0a0a0c;
  --badge-locked-bg: #e2e2e8;
  --badge-size: 128rpx;
  --button-bg: #0a0a0c;
  --button-border-width: 1px;
  --button-fg: #ffffff;
  --button-font-size: 28rpx;
  --button-gap: 16rpx;
  --button-ghost-border: #c9c9d1;
  --button-height: 88rpx;
  --button-padding-inline: 40rpx;
  --button-pressed-scale: 0.97;
  --button-radius: 44rpx;
  --button-secondary-bg: #e7e7ec;
  --button-secondary-fg: #0a0a0c;
  --card-bg: #ffffff;
  --card-border: #e2e2e8;
  --card-gap: 24rpx;
  --card-padding: 32rpx;
  --card-radius: 52rpx;
  --card-shadow: 0px 1px 2px rgba(10, 10, 12, 0.06);
  --chip-active-bg: #ffffff;
  --chip-active-fg: #0a0a0c;
  --chip-bg: #ececf0;
  --chip-border: #e2e2e8;
  --chip-fg: #4b4b52;
  --chip-height: 88rpx;
  --chip-padding-inline: 24rpx;
  --chip-radius: 1998rpx;
  --color-action-ghost-border: #c9c9d1;
  --color-action-on-primary: #ffffff;
  --color-action-on-secondary: #0a0a0c;
  --color-action-primary: #0a0a0c;
  --color-action-primary-hover: #26262b;
  --color-action-primary-pressed: #000000;
  --color-action-secondary: #e7e7ec;
  --color-border-focus: #0a0a0c;
  --color-border-strong: #c9c9d1;
  --color-border-subtle: #e2e2e8;
  --color-brand-halo: #dcdce3;
  --color-brand-mark: #6e6e73;
  --color-budget-fill: #0a0a0c;
  --color-budget-over: #a5783d;
  --color-budget-track: #e6e3d7;
  --color-category-dining: #cf9c57;
  --color-category-subscription: #ab7b5d;
  --color-category-transit: #7c9ead;
  --color-ink-inverse: #f7f7fa;
  --color-ink-on-accent: #0a0a0c;
  --color-ink-primary: #0a0a0c;
  --color-ink-secondary: #4b4b52;
  --color-ink-tertiary: #63636a;
  --color-overlay-scrim: rgba(23, 24, 15, 0.42);
  --color-status-danger: #8a4a5e;
  --color-status-danger-soft: #f7dfe4;
  --color-status-info: #46656f;
  --color-status-info-soft: #ddeaf0;
  --color-status-success: #4e633d;
  --color-status-success-soft: #e9f0df;
  --color-status-warning: #84592e;
  --color-status-warning-soft: #f7e8cc;
  --color-surface-accent-soft: #ededf1;
  --color-surface-canvas: #f5f5f7;
  --color-surface-inverse: #0a0a0c;
  --color-surface-raised: #ffffff;
  --color-surface-sunken: #ececf0;
  --color-transaction-expense: #8a4a5e;
  --color-transaction-income: #4e633d;
  --color-transaction-transfer: #46656f;
  --elevation-overlay: 0px 24px 64px rgba(23, 24, 15, 0.18);
  --elevation-raised: 0px 14px 34px rgba(10, 10, 12, 0.1);
  --elevation-subtle: 0px 1px 2px rgba(10, 10, 12, 0.06);
  --field-bg: #ffffff;
  --field-border: #e2e2e8;
  --field-border-focus: #0a0a0c;
  --field-height: 88rpx;
  --field-label: #63636a;
  --field-padding-inline: 24rpx;
  --field-placeholder: #63636a;
  --field-radius: 44rpx;
