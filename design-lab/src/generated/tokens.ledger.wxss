  --metric-label-tracking: 1.2px;
}

.layout-expanded {
  --layout-gutter: var(--layout-gutter-tablet);
  --layout-content-max: var(--layout-content-max-tablet);
  --type-display-size: 34.6px;
  --type-display-line: 41px;
  --type-display-tracking: -0.9px;
