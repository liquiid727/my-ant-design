{
  "$schema": "design-lab/design-context@2",
  "app": {
    "id": "ride",
    "label": "骑行"
  },
  "units": {
    "authoring": "px @ 375 设计宽",
    "web": "px",
    "weapp": "rpx（px × 2）；1px 发丝线保持 px"
  },
  "layers": {
    "primitive": "原始色阶与刻度，业务不可引用",
    "semantic": "用途语义，品牌包覆盖的唯一入口",
    "brand": "品牌包：只允许覆盖白名单内的键",
    "product": "本产品专有的业务语义",
    "component": "组件私有变量，只引用语义层"
  },
  "components": [
    {
      "name": "Action",
      "purpose": "唯一的操作入口：主 / 次 / 幽灵三档，覆盖按压反馈",
      "props": [
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "variant",
          "type": "'primary' | 'secondary' | 'ghost'",
          "default": "primary"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": false
        },
        {
          "name": "onClick",
          "type": "() => void"
        }
      ],
      "states": [
        "default",
        "pressed",
        "disabled",
        "focus"
      ],
      "tokens": [
        "button.height",
        "button.radius",
        "button.padding-inline",
        "button.bg",
        "button.fg",
        "button.pressed-scale",
        "motion.duration.fast",
        "motion.easing.standard",
        "size.touch-min"
      ],
      "rules": [
        "按压缩放不超过 3%",
        "触控高度不低于 size.touch-min",
        "禁用态不降低对比度以外的可读性"
      ]
    },
    {
      "name": "Metric",
      "purpose": "以等宽数字呈现单个骑行指标（距离 / 爬升 / 时长 / 均速）",
      "props": [
        {
          "name": "value",
          "type": "number",
          "required": true,
          "note": "数值本体；格式化在 ds-core 完成，组件不解析业务数据"
        },
        {
          "name": "unit",
          "type": "string",
          "enum": [
            "km",
            "m",
            "min",
            "km/h",
            "kcal"
          ]
        },
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "tone",
          "type": "'default' | 'muted'",
          "default": "default"
        },
        {
          "name": "size",
          "type": "'md' | 'lg'",
          "default": "md"
        }
      ],
      "states": [
        "default",
        "muted"
      ],
      "tokens": [
        "metric.value-size",
        "metric.value-line",
        "metric.unit-size",
        "metric.label-size",
        "metric.ink",
        "metric.muted-ink",
        "metric.family"
      ],
      "rules": [
        "不承载交互",
        "数值与单位之间不断行",
        "标签不超过 6 个汉字"
      ]
    },
    {
      "name": "ProgressRing",
      "purpose": "用环形成绩表达完成度，骑行结束页的主视觉",
      "props": [
        {
          "name": "value",
          "type": "number",
          "required": true,
          "note": "0–1"
        },
        {
          "name": "size",
          "type": "'sm' | 'md' | 'lg'",
          "default": "md"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "animate",
          "type": "boolean",
          "default": true,
          "note": "遵循 prefers-reduced-motion"
        }
      ],
      "states": [
        "idle",
        "animating",
        "complete",
        "reduced-motion"
      ],
      "tokens": [
        "ring.size",
        "ring.stroke",
        "ring.track",
        "ring.fill",
        "ring.ink",
        "motion.duration.celebrate",
        "motion.easing.spring"
      ],
      "rules": [
        "进度只从 0 增长，不回退",
        "完成时只做一次庆祝动效",
        "reduced-motion 下直接落位"
      ]
    },
    {
      "name": "RouteCard",
      "purpose": "路线卡片：地图缩略 + 距离 / 爬升 / 时长 + 一个动作",
      "props": [
        {
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "name": "distanceKm",
          "type": "number",
          "required": true
        },
        {
          "name": "elevationM",
          "type": "number"
        },
        {
          "name": "durationMin",
          "type": "number"
        },
        {
          "name": "surface",
          "type": "'road' | 'gravel' | 'mixed'",
          "default": "mixed"
        },
        {
          "name": "layout",
          "type": "'card' | 'row'",
          "default": "card",
          "note": "row 用于列表密度场景，隐藏地图"
        },
        {
          "name": "onSelect",
          "type": "() => void"
        }
      ],
      "states": [
        "default",
        "pressed",
        "loading",
        "empty"
      ],
      "tokens": [
        "card.radius",
        "card.padding",
        "card.bg",
        "card.border",
        "route.card.map-height",
        "route.card.gap",
        "color.route.primary",
        "color.route.elevation"
      ],
      "rules": [
        "地图区域不得挤压指标区",
        "空态给出下一步动作，不显示 0 值占位"
      ]
    }
  ],
